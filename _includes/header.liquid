<header>
  <nav id="navbar" class="navbar navbar-light {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <a class="navbar-brand site-name" href="{{ '/' | relative_url }}">
        <span class="font-weight-bold">{{ site.first_name }}</span>
        {%- if site.middle_name %} {{ site.middle_name }}{% endif %}
        {{ site.last_name }}
      </a>
      <div class="navbar-links">
        {% assign scholar_id = site.data.socials.scholar_userid %}
        <a class="nav-link" href="https://scholar.google.com/citations?user={{ scholar_id }}" target="_blank" rel="noopener noreferrer">scholar</a>
        <a class="nav-link" href="{{ site.cv_url }}" target="_blank" rel="noopener noreferrer">cv</a>
        {% if site.posts.size > 0 %}
          <a class="nav-link" href="{{ '/blog/' | relative_url }}">blog</a>
        {% endif %}
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dusk theme" title="Switch to dusk theme">
          <svg class="theme-toggle__moon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M20.2 15.3A8.6 8.6 0 0 1 8.7 3.8 8.6 8.6 0 1 0 20.2 15.3Z"/>
          </svg>
          <svg class="theme-toggle__sun" aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="3.6"/>
            <path d="M12 2v2.1M12 19.9V22M2 12h2.1M19.9 12H22M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M19.1 4.9l-1.5 1.5M6.4 17.6l-1.5 1.5"/>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>
