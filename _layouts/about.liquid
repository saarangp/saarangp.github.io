---
layout: default
---
{% assign about_sections = content | split: '<!--about-me-->' %}

<div class="home">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="home-hero__eyebrow">{{ page.hero.eyebrow }}</p>
      <h1 id="home-title">{{ page.hero.title }}</h1>
      <p class="home-hero__statement">{{ page.hero.statement }}</p>
      <div class="home-hero__actions">
        <div class="home-hero__links" aria-label="Quick links">
          <a href="#selected-work">see my work <span aria-hidden="true">↓</span></a>
          <a href="mailto:{{ site.data.socials.email }}">email me <span aria-hidden="true">↗</span></a>
        </div>
        {% if page.profile.image %}
          <div class="home-hero__profile">
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% include figure.liquid loading="eager" path=profile_image_path class="home-hero__portrait" sizes="120px" alt=page.profile.alt cache_bust=true %}
          </div>
        {% endif %}
      </div>
    </div>
    <div class="home-hero__art">
      {% include neural-sunset.liquid id="hero" %}
    </div>
  </section>

  <main class="home-main">
    <div class="home-intro">{{ about_sections[0] }}</div>

    {% if page.selected_papers %}
      <section class="home-section home-work" id="selected-work" aria-labelledby="selected-work-title">
        <div class="section-heading">
          <div>
            <h2 id="selected-work-title">selected work</h2>
          </div>
          <a
            class="section-link"
            href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
            target="_blank"
            rel="noopener noreferrer"
            >all publications <span aria-hidden="true">↗</span></a
          >
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section home-news" id="news" aria-labelledby="news-title">
        <div class="section-heading">
          <div>
            <h2 id="news-title">news</h2>
          </div>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if about_sections.size > 1 %}
      <section class="home-section home-about" id="about" aria-labelledby="about-title">
        <div class="section-heading">
          <div>
            <h2 id="about-title">about me</h2>
          </div>
        </div>
        <div class="home-about__copy">{{ about_sections[1] }}</div>
        {% if page.social %}
          <div class="social">
            <div class="contact-icons" aria-label="Contact links">{% include social.liquid %}</div>
            <div class="contact-note">{{ site.contact_note }}</div>
          </div>
        {% endif %}
      </section>
    {% endif %}
  </main>
</div>
